{
  "name": "ugcraft-ai",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "AI-Powered UGC Advertising Content Generator for Brands, Creators & Agencies",
  "scripts": {
    "dev": "concurrently -k -n \"CLIENT,SERVER\" -c \"magenta,cyan\" \"npm run dev:client\" \"npm run dev:server\"",
    "dev:client": "vite",
    "dev:server": "node server/index.js",
    "build": "tsc -b && vite build",
    "test": "node scripts/test-runner.js",
    "start": "node server/index.js",
    "preview": "vite preview"
  },
  "dependencies": {
    "@google/genai": "^2.28.0",
    "autoprefixer": "^10.6.1",
    "concurrently": "^10.0.6",
    "cors": "^2.8.6",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "lucide-react": "^1.55.0",
    "postcss": "^8.5.29",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^3.4.19"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
